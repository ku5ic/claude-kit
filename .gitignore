# Skills the Claude desktop app syncs in; machine-local.
skills/synced/
# Built by go/build.sh or KIT_DEV=1, downloaded from releases otherwise.
bin/kit-*
# Written by the engine when it loads the mods; extends the ignored .claude-plugin/types/.
/tsconfig.json
# memory: local agents write here under the session's cwd, which can be any subfolder.
**/.claude/agent-memory-local/
