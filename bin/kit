#!/usr/bin/env bash
# Runs the kit binary for this OS, CPU, and plugin version
# (bin/kit-<version>-<os>-<arch>). Fast path is builtins only: every hook
# call pays for this, and uname or dirname forks cost more than the binary
# itself. Runs under the stock macOS bash 3.2. hooks.json and every caller
# run it directly: `kit <subcommand>`, `kit hook <name>`.
#
# The version comes from .claude-plugin/plugin.json, so a checkout that a
# release moved never reuses an older binary. A missing binary is built from
# source with KIT_DEV=1 (and rebuilt when go/ is newer), else run from the
# plugin cache's copy of the same version, else downloaded from the matching
# GitHub release and checked against its .sha256. Still none: a
# hook fails open (exit 0), the SessionStart hook says so, and any other
# command fails with the reason.
case $OSTYPE in
darwin*) os=darwin ;;
linux*) os=linux ;;
*) os=$OSTYPE ;;
esac
case $HOSTTYPE in
arm64 | aarch64) arch=arm64 ;;
x86_64 | amd64) arch=amd64 ;;
*) arch=$HOSTTYPE ;;
esac
self=${BASH_SOURCE[0]}
# A symlink to this file itself (not to its directory) needs its target's dir.
while [[ -L $self ]]; do
  link=$(readlink "$self")
  [[ $link == /* ]] || link=${self%/*}/$link
  self=$link
done
dir=${self%/*}
[[ $dir == "$self" ]] && dir=.
# Absolute: the KIT_DEV build runs in go/, and its -o must still land in bin/.
[[ $dir == /* ]] || dir=$PWD/$dir
ver=
manifest="$dir/../.claude-plugin/plugin.json"
if [[ -r $manifest ]]; then
  version_re='"version"[[:space:]]*:[[:space:]]*"([^"]+)"'
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ $version_re ]]; then
      ver=${BASH_REMATCH[1]}
      break
    fi
  done <"$manifest"
fi
bin="$dir/kit-$ver-$os-$arch"
if [[ ${KIT_DEV:-} == 1 ]]; then
  # Its own name: a release name always means the release asset.
  bin="$dir/kit-dev-$os-$arch"
elif [[ -x $bin ]]; then
  exec "$bin" "$@"
# Claude Code runs hooks from cache/<marketplace>/kit/<version>/ and the
# status line from marketplaces/<marketplace>/, so a download into one leaves
# the other empty (code.claude.com/docs/en/plugins/loading).
elif [[ -n $ver && $dir =~ ^(.*)/marketplaces/([^/]+)/bin$ ]]; then
  cached="${BASH_REMATCH[1]}/cache/${BASH_REMATCH[2]}/kit/$ver/bin/${bin##*/}"
  [[ -x $cached ]] && exec "$cached" "$@"
fi

# Slow path, once per version: forks are fine here. The temp name keeps
# hooks running in parallel from exec'ing a half-written binary.
tmp="$bin.$$"
# Other versions' binaries and backoff markers, every platform's, and temps
# a killed hook stranded, once old enough not to be in flight. This
# version's release names stay even under KIT_DEV: go/build.sh writes them,
# and e2e runs this platform's.
prune() {
  local f name binary_re='^kit-.+-[a-z0-9]+-[a-z0-9]+(\.failed)?$'
  for f in "$dir"/kit-*; do
    name=${f##*/}
    case $name in
    kit-"$ver"-* | kit-dev-*) continue ;;
    esac
    [[ $name =~ $binary_re ]] && rm -f "$f"
  done
  find "$dir" -maxdepth 1 -name "kit-*-$os-$arch.[0-9]*" -mmin +10 -delete 2>/dev/null
}
if [[ ${KIT_DEV:-} == 1 ]]; then
  # Any source file counts: embedded prompts and go.mod change the build too.
  if [[ ! -x $bin || -n $(find "$dir/../go" -type f ! -name '*_test.go' -newer "$bin" -print -quit 2>/dev/null) ]]; then
    # Before the build: a hook's timeout can kill this shell mid-build.
    prune
    "$dir/../go/build.sh" -o "$tmp" >&2 && mv -f "$tmp" "$bin"
  fi
# Only the CLI and the inject-context hook, with its 45s timeout, download.
# A hook with a 5 to 20s timeout would be killed before curl's 25s, and a
# status line is cancelled on each refresh, so either would strand its temp
# file. A failed download backs off for a minute so offline sessions start
# fast.
elif [[ -n $ver && ((${1:-} != hook && ${1:-} != *statusline) ||
  ${2:-} == inject-context) &&
  -z $(find "$bin.failed" -mmin -1 2>/dev/null) ]]; then
  url="https://github.com/ku5ic/claude-kit/releases/download/v$ver/kit-$ver-$os-$arch"
  # The release's .sha256 must match before the binary runs: a truncated or
  # altered download never gets exec'd.
  if want=$(curl -fsSL --proto =https --proto-redir =https --max-time 5 "$url.sha256") &&
    curl -fsSL --proto =https --proto-redir =https --max-time 20 -o "$tmp" "$url" &&
    { got=$(sha256sum "$tmp" 2>/dev/null) || got=$(shasum -a 256 "$tmp"); } &&
    [[ -n ${want%% *} && ${got%% *} == "${want%% *}" ]] &&
    chmod +x "$tmp" && mv -f "$tmp" "$bin"; then
    rm -f "$bin.failed"
    prune
  else
    touch "$bin.failed"
  fi
fi
rm -f "$tmp"
if [[ -x $bin ]]; then
  exec "$bin" "$@"
fi
reason="kit: no binary for $os-$arch at $bin; the next session start downloads it if a release ships one for this platform, or build it with go/build.sh"
if [[ ${1:-} == hook ]]; then
  reason=${reason/;/, so every claude-kit guard is off;}
  echo "$reason" >&2
  # SessionStart is the one hook whose output both the user and Claude see.
  if [[ ${2:-} == inject-context ]]; then
    reason=${reason//\\/\\\\}
    reason=${reason//\"/\\\"}
    printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$reason" "$reason"
  fi
  exit 0
fi
echo "$reason" >&2
exit 127
