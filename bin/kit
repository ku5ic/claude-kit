#!/usr/bin/env bash
# Runs the kit binary for this OS, CPU, and plugin version
# (bin/kit-<version>-<os>-<arch>). Fast path is builtins only: every hook
# call pays for this, and uname or dirname forks cost more than the binary
# itself. Runs under the stock macOS bash 3.2. Shims source it rather than
# exec it, saving a second bash startup (~10 ms).
#
# The version comes from .claude-plugin/plugin.json, so a checkout that a
# release moved never reuses an older binary. A missing binary is built from
# source with KIT_DEV=1 (and rebuilt when go/ is newer), else downloaded from
# the matching GitHub release. Still none: a hook fails open (exit 0), the
# SessionStart hook says so, and any other command fails with the reason.
case $OSTYPE in
darwin*) os=darwin ;;
linux*) os=linux ;;
*) os=$OSTYPE ;;
esac
case $HOSTTYPE in
arm64 | aarch64) arch=arm64 ;;
x86_64 | amd64) arch=amd64 ;;
*) arch=$HOSTTYPE ;;
esac
self=${BASH_SOURCE[0]}
# A symlink to this file itself (not to its directory) needs its target's dir.
while [[ -L $self ]]; do
  link=$(readlink "$self")
  [[ $link == /* ]] || link=${self%/*}/$link
  self=$link
done
dir=${self%/*}
[[ $dir == "$self" ]] && dir=.
ver=
manifest="$dir/../.claude-plugin/plugin.json"
if [[ -r $manifest ]]; then
  version_re='"version"[[:space:]]*:[[:space:]]*"([^"]+)"'
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ $version_re ]]; then
      ver=${BASH_REMATCH[1]}
      break
    fi
  done <"$manifest"
fi
bin="$dir/kit-$ver-$os-$arch"
if [[ -x $bin && ${KIT_DEV:-} != 1 ]]; then
  exec "$bin" "$@"
fi

# Slow path, once per version: forks are fine here. The temp name keeps
# hooks running in parallel from exec'ing a half-written binary.
tmp="$bin.$$"
if [[ ${KIT_DEV:-} == 1 ]]; then
  if [[ ! -x $bin || -n $(find "$dir/../go" -name '*.go' -newer "$bin" -print -quit 2>/dev/null) ]]; then
    (cd "$dir/../go" && CGO_ENABLED=0 go build -trimpath -buildvcs=false \
      -ldflags="-s -w -buildid= -X main.version=$ver" -o "$tmp" ./cmd/kit) >&2 &&
      mv -f "$tmp" "$bin"
  fi
elif [[ -n $ver && -z $(find "$bin.failed" -mmin -1 2>/dev/null) ]]; then
  # A failed download backs off for a minute: offline, every hook would
  # otherwise wait out curl's timeout, which outlasts guard-bash's.
  if curl -fsSL --max-time 20 -o "$tmp" \
    "https://github.com/ku5ic/claude-kit/releases/download/v$ver/kit-$ver-$os-$arch" &&
    chmod +x "$tmp" && mv -f "$tmp" "$bin"; then
    rm -f "$bin.failed"
  else
    touch "$bin.failed"
  fi
fi
rm -f "$tmp"
if [[ -x $bin ]]; then
  exec "$bin" "$@"
fi
reason="kit: no binary for $os-$arch at $bin, so every claude-kit guard is off; build it with go/build.sh, or set KIT_DEV=1"
echo "$reason" >&2
if [[ ${1:-} == hook ]]; then
  # SessionStart is the one hook whose output both the user and Claude see.
  if [[ ${2:-} == inject-context ]]; then
    reason=${reason//\\/\\\\}
    reason=${reason//\"/\\\"}
    printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$reason" "$reason"
  fi
  exit 0
fi
exit 127
