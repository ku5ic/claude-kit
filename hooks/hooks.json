{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook guard-bash", "timeout": 10 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook guard-commit", "timeout": 5 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Read",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook guard-dispatch", "timeout": 5 }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook sanitize-output", "timeout": 5 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook format-dispatch", "timeout": 15 }
        ]
      },
      {
        "matcher": "Read|Skill",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook log-skills", "timeout": 5 }]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook plan-mode-context", "timeout": 5 }]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook inject-context", "timeout": 30 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook inject-rules 1", "timeout": 30 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook inject-rules 2", "timeout": 30 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook inject-rules 3", "timeout": 30 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook inject-rules 4", "timeout": 30 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook inject-rules 5", "timeout": 30 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook inject-rules 6", "timeout": 30 }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook log-skills", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook plan-mode-context", "timeout": 5 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook stop-checks", "timeout": 300 }]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "general-purpose",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook review-checks", "timeout": 5 }]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook inject-subagent-context", "timeout": 5 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook inject-rules 1", "timeout": 30 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook inject-rules 2", "timeout": 30 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook inject-rules 3", "timeout": 30 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook inject-rules 4", "timeout": 30 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook inject-rules 5", "timeout": 30 },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/kit\" hook inject-rules 6", "timeout": 30 }
        ]
      }
    ]
  }
}
